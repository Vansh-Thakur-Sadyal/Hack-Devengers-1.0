# ==========================================
# Environment configuration — SAMPLE FILE
# ==========================================
# Copy this file to ".env" and fill in real values.
# NEVER commit the real .env file — it is ignored via .gitignore.

# --- Mistral AI (required for the LLM-powered agents & chatbot) ---
# Get a key from https://console.mistral.ai/
MISTRAL_API_KEY=your-mistral-api-key-here

# --- Weather API (optional) ---
WEATHER_API_KEY=your-weather-api-key-here

# --- Storage (optional overrides) ---
STORAGE_TYPE=json
JSON_STORAGE_PATH=storage/data.json

# --- MQTT sensor broker (optional, for simulated sensors) ---
MQTT_BROKER=localhost
MQTT_PORT=1883
MQTT_TOPIC=farm/sensors

# --- Logging ---
LOG_LEVEL=INFO
